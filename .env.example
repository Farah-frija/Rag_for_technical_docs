# Copy this file to `.env` and fill in what you need.
# Every value here has a sane default in manual_rag/config.py; you only
# need to set what you're changing.

# ── LLM provider ─────────────────────────────────────────────────────────
# "gemini" (default, cloud) or "ollama" (local model, no API key needed)
MANUAL_RAG_LLM_PROVIDER=gemini
GEMINI_API_KEY=
MANUAL_RAG_LLM_GEMINI_MODEL=gemini-3.1-flash-lite

# If MANUAL_RAG_LLM_PROVIDER=ollama:
MANUAL_RAG_LLM_OLLAMA_HOST=http://localhost:11434
MANUAL_RAG_LLM_OLLAMA_MODEL=llama3.1

MANUAL_RAG_LLM_MIN_CALL_INTERVAL_SEC=4.1
MANUAL_RAG_LLM_MAX_RETRIES=2

# ── Embeddings ───────────────────────────────────────────────────────────
MANUAL_RAG_EMBED_PROVIDER=sentence_transformers
MANUAL_RAG_EMBED_MODEL_NAME=all-mpnet-base-v2

# ── Reranker ─────────────────────────────────────────────────────────────
# "cross_encoder" (default) or "none" (fast, no-op -- useful for smoke tests)
MANUAL_RAG_RERANKER_PROVIDER=cross_encoder
MANUAL_RAG_RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# ── Vector store ─────────────────────────────────────────────────────────
# "chroma" (default, embedded/persistent) or "in_memory" (no dependency, non-persistent)
MANUAL_RAG_VECTORSTORE_PROVIDER=chroma
MANUAL_RAG_VECTORSTORE_PERSIST_DIR=./data/chroma
MANUAL_RAG_VECTORSTORE_COLLECTION_NAME=manual_rag_chunks

# ── Retrieval defaults ───────────────────────────────────────────────────
# "tree" (hierarchical, highest quality), "vanilla" (dense+BM25 baseline),
# or "page_index" (pure LLM traversal, no embeddings needed)
MANUAL_RAG_RETRIEVAL_DEFAULT_STRATEGY=tree

# ── Indexing ─────────────────────────────────────────────────────────────
MANUAL_RAG_INDEXING_AUTO_RETRIEVE_ON_COMPLETE=true

# ── Logging ──────────────────────────────────────────────────────────────
MANUAL_RAG_LOG_LEVEL=INFO
MANUAL_RAG_LOG_DIR=./logs
MANUAL_RAG_LOG_JSON_LOGS=true
